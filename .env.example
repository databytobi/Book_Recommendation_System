# ============================================================
# ENVIRONMENT TEMPLATE
#
# Copy to `.env` for local development:
#     cp .env.example .env
#
# Generate strong secrets with:
#     python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# NEVER commit the real `.env`. It is git-ignored.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME=Book Recommendation System
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# development | testing | staging | production
ENVIRONMENT=development

# Must be False in production.
DEBUG=True

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------
# DATABASE
# Local: localhost. Docker Compose: postgres
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/book_recommendation_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=False

# ------------------------------------------------------------
# REDIS
# Local: localhost. Docker Compose: redis
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# ------------------------------------------------------------
# SECURITY  — REQUIRED, no usable default exists
# The application refuses to start in staging/production if these
# are empty, left at a placeholder, or shorter than 32 characters.
# ------------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Guards the /admin/* operational endpoints (registry status, ML reload).
# Send it as the `X-Admin-Key` header.
#
# In staging/production these endpoints are DISABLED (HTTP 503) unless this is
# set, so set it to use `POST /admin/reload` after refreshing model artifacts.
# In development/testing an unset value allows access.
ADMIN_API_KEY=CHANGE_ME_generate_another_long_random_string

# ------------------------------------------------------------
# CORS — comma-separated list of allowed browser origins
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-Process-Time

# ------------------------------------------------------------
# EMAIL (password reset / verification)
# Leave SMTP_USER and SMTP_PASSWORD blank to disable outbound email;
# the API logs reset links instead of sending them.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
SMTP_SSL=False

# ------------------------------------------------------------
# RECOMMENDER
# Weights must sum to 1.0 (they are renormalised if they do not).
# ------------------------------------------------------------
HYBRID_COLLABORATIVE_WEIGHT=0.50
HYBRID_CONTENT_WEIGHT=0.30
HYBRID_POPULARITY_WEIGHT=0.20
MIN_RATINGS_THRESHOLD=50
DEFAULT_TOP_K=10

# ------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD=60

# ------------------------------------------------------------
# FRONTEND  (also lives in apps/frontend/web/.env.local)
# Baked into the client bundle at build time — set it before building.
# ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------
# PRODUCTION COMPOSE ONLY (docker-compose.prod.yml)
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password
POSTGRES_DB=book_recommendation_db
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_strong_grafana_password
GRAFANA_ROOT_URL=http://localhost/grafana