# Environment
ENVIRONMENT=docker
DEBUG=True
LOG_LEVEL=INFO

# Docker-specific environment variables
DATABASE_URL=postgresql://postgres:root@postgres:5432/book_recommendation

# Redis
REDIS_URL=redis://redis:6379/0

APP_NAME=Book Recommendation System
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# Security
SECRET_KEY=docker-secret-key-change-in-production
JWT_SECRET=docker-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

# ML Configuration
HYBRID_COLLABORATIVE_WEIGHT=0.50
HYBRID_CONTENT_WEIGHT=0.30
HYBRID_POPULARITY_WEIGHT=0.20
MIN_RATINGS_THRESHOLD=50

# Artifacts
ARTIFACTS_DIR=/app/ml/artifacts
MODELS_DIR=/app/ml/models

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000